import class TestCase, TestSuite, TestOptions, TestOutcome, RunSummary from "ores.std/testing";
import fnc expect_true, expect_false, expect_equal_int, expect_equal_string, expect_near_float, run_suite, require_success, fail from "ores.std/testing";
import fnc may_open_tab, may_focus_tab, may_persist_tab_session from "../src/desktop/tab_policy";
fnc cross_tenant_tab_open_denied(): TestOutcome {
  return expect_false(may_open_tab(1, 2, 1, 1, 0, 8, true, false, false),
    "cross-tenant tab creation must fail closed");
}
fnc stale_generation_focus_denied(): TestOutcome {
  return expect_false(may_focus_tab(3, 3, 7, 7, 10, 9, true, true, true),
    "trusted gesture cannot bypass generation mismatch");
}
fnc private_session_never_persists(): TestOutcome {
  return expect_false(may_persist_tab_session(1, 1, 5, 5, true, true, true, true),
    "private browsing state must not be serialized to session restore");
}
fnc trusted_same_tenant_open_is_admitted(): TestOutcome {
  return expect_true(may_open_tab(4, 4, 9, 9, 0, 8, true, false, false),
    "live same-tenant same-profile nonprivate tab should be admitted");
}

fnc tab_limit_is_fail_closed(): TestOutcome {
  return expect_false(may_open_tab(4, 4, 9, 9, 8, 8, true, false, false),
    "tabs cannot exceed configured window quota");
}

fnc untrusted_chrome_focus_gesture_is_rejected(): TestOutcome {
  return expect_false(may_focus_tab(3, 3, 7, 7, 10, 10, true, true, false),
    "renderer-controlled focus must not impersonate trusted tab-strip input");
}

fnc nonprivate_persistence_with_unlocked_storage_is_allowed(): TestOutcome {
  return expect_true(may_persist_tab_session(1, 1, 5, 5, false, false, true, true),
    "same-tenant nonprivate session restore is allowed with explicit enablement");
}

pub routine main(): void {
  val TestSuite suite = new TestSuite("browser-policy", arr[
    new TestCase("cross_tenant_tab_open_denied", cross_tenant_tab_open_denied, false, ""),
    new TestCase("stale_generation_focus_denied", stale_generation_focus_denied, false, ""),
    new TestCase("private_session_never_persists", private_session_never_persists, false, ""),
    new TestCase("trusted_same_tenant_open_is_admitted", trusted_same_tenant_open_is_admitted, false, ""),
    new TestCase("tab_limit_is_fail_closed", tab_limit_is_fail_closed, false, ""),
    new TestCase("untrusted_chrome_focus_gesture_is_rejected", untrusted_chrome_focus_gesture_is_rejected, false, ""),
    new TestCase("nonprivate_persistence_with_unlocked_storage_is_allowed", nonprivate_persistence_with_unlocked_storage_is_allowed, false, "")
  ]);
  val TestOptions options = new TestOptions("", false, true);
  val RunSummary summary = run_suite(rt borrow suite, rt borrow options);
  require_success(rt borrow summary);
  return;
}
