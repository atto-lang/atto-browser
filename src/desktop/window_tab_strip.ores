// Native window tab-strip actor: index ordering and focus policy.
// Presentation indices are NOT stable tab identities; trusted browser must
// map indices to generation-fenced tab IDs after a close/reorder.
// Bounded to 64 tabs. The UI/OS window adapter is still unimplemented.
define actor WindowTabStripActor as
  let int tab_count = 0;
  let int selected_index = 0;

  receive(ActorMail<String> mail): void {
    if mail.value == "new"; do
      if self.tab_count >= 64; do self.send(-1); return; fi
      self.tab_count = self.tab_count + 1;
      self.selected_index = self.tab_count;
      self.send(self.selected_index); return;
    fi
    if mail.value == "next"; do
      if self.tab_count <= 0; do self.send(-1); return; fi
      if self.selected_index == self.tab_count; do
        self.selected_index = 1;
      else
        self.selected_index = self.selected_index + 1;
      fi
      self.send(self.selected_index); return;
    fi
    if mail.value == "previous"; do
      if self.tab_count <= 0; do self.send(-1); return; fi
      if self.selected_index <= 1; do
        self.selected_index = self.tab_count;
      else
        self.selected_index = self.selected_index - 1;
      fi
      self.send(self.selected_index); return;
    fi
    if mail.value == "close-tab"; do
      if self.tab_count <= 0; do self.send(-1); return; fi
      self.tab_count = self.tab_count - 1;
      if self.selected_index > self.tab_count; do
        self.selected_index = self.tab_count;
      fi
      self.send(self.selected_index); return;
    fi
    if mail.value == "quit"; do
      self.send(0);
      self.end();
      return;
    fi
    self.send(-1);
    return;
  }
end

pub async routine main(): void {
  val win = await spawn WindowTabStripActor();
  win.send("next");
  val empty = (await win.outputs.next()).value.unwrap();
  if empty.value != -1; do
    stdio.stdout.write("FAIL:empty-strip"); return;
  fi
  win.send("new");
  val first = (await win.outputs.next()).value.unwrap();
  if first.value != 1; do
    stdio.stdout.write("FAIL:new-first"); return;
  fi
  win.send("new");
  val second = (await win.outputs.next()).value.unwrap();
  if second.value != 2; do
    stdio.stdout.write("FAIL:new-second"); return;
  fi
  win.send("previous");
  val previous = (await win.outputs.next()).value.unwrap();
  if previous.value != 1; do
    stdio.stdout.write("FAIL:previous"); return;
  fi
  win.send("next");
  val next = (await win.outputs.next()).value.unwrap();
  if next.value != 2; do
    stdio.stdout.write("FAIL:next"); return;
  fi
  win.send("close-tab");
  val remaining = (await win.outputs.next()).value.unwrap();
  if remaining.value != 1; do
    stdio.stdout.write("FAIL:close-selected"); return;
  fi
  win.send("next");
  val wrap = (await win.outputs.next()).value.unwrap();
  if wrap.value != 1; do
    stdio.stdout.write("FAIL:wrap"); return;
  fi
  win.send("close-tab");
  val none = (await win.outputs.next()).value.unwrap();
  if none.value != 0; do
    stdio.stdout.write("FAIL:close-last"); return;
  fi
  win.send("quit");
  val stopped = (await win.outputs.next()).value.unwrap();
  await win.get_done();
  if stopped.value != 0; do
    stdio.stdout.write("FAIL:quit"); return;
  fi
  stdio.stdout.write("browser:tab-strip-ok");
  return;
}
