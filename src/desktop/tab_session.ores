// One long-lived actor per tab: first native history navigation proof.
// The trusted window supervisor will own the unbounded tab strip and URLs.
// These string messages are LOCAL TEST COMMANDS, not production IPC.
define actor TabSessionActor as
  let int back_depth = 0;
  let int forward_depth = 0;

  receive(ActorMail<String> mail): void {
    if mail.value == "navigate"; do
      if self.back_depth >= 1024; do
        self.send("history-full"); return;
      fi
      self.back_depth = self.back_depth + 1;
      self.forward_depth = 0;
      self.send("navigated"); return;
    fi
    if mail.value == "back"; do
      if self.back_depth <= 1; do
        self.send("no-back"); return;
      fi
      self.back_depth = self.back_depth - 1;
      self.forward_depth = self.forward_depth + 1;
      self.send("back"); return;
    fi
    if mail.value == "forward"; do
      if self.forward_depth <= 0; do
        self.send("no-forward"); return;
      fi
      self.back_depth = self.back_depth + 1;
      self.forward_depth = self.forward_depth - 1;
      self.send("forward"); return;
    fi
    if mail.value == "close"; do
      self.send("closed");
      self.end();
      return;
    fi
    self.send("rejected");
    return;
  }
end

pub async routine main(): void {
  // Two independent tabs share no mutable history data.
  val first = await spawn TabSessionActor();
  val second = await spawn TabSessionActor();
  first.send("navigate");
  val first_one = (await first.outputs.next()).value.unwrap();
  second.send("navigate");
  val second_one = (await second.outputs.next()).value.unwrap();
  if first_one.value != "navigated" || second_one.value != "navigated"; do
    stdio.stdout.write("FAIL:initial-tabs"); return;
  fi

  first.send("navigate");
  val first_two = (await first.outputs.next()).value.unwrap();
  if first_two.value != "navigated"; do
    stdio.stdout.write("FAIL:second-navigation"); return;
  fi
  first.send("back");
  val back = (await first.outputs.next()).value.unwrap();
  if back.value != "back"; do
    stdio.stdout.write("FAIL:back"); return;
  fi
  second.send("back");
  val second_back = (await second.outputs.next()).value.unwrap();
  if second_back.value != "no-back"; do
    stdio.stdout.write("FAIL:cross-tab-state"); return;
  fi
  first.send("forward");
  val forward = (await first.outputs.next()).value.unwrap();
  if forward.value != "forward"; do
    stdio.stdout.write("FAIL:forward"); return;
  fi
  first.send("back");
  val back_again = (await first.outputs.next()).value.unwrap();
  if back_again.value != "back"; do
    stdio.stdout.write("FAIL:back-again"); return;
  fi
  first.send("navigate");
  val nav = (await first.outputs.next()).value.unwrap();
  if nav.value != "navigated"; do
    stdio.stdout.write("FAIL:new-navigation"); return;
  fi
  first.send("forward");
  val forward_cleared = (await first.outputs.next()).value.unwrap();
  if forward_cleared.value != "no-forward"; do
    stdio.stdout.write("FAIL:forward-not-cleared"); return;
  fi
  first.send("close");
  second.send("close");
  val first_closed = (await first.outputs.next()).value.unwrap();
  val second_closed = (await second.outputs.next()).value.unwrap();
  await first.get_done();
  await second.get_done();
  if first_closed.value != "closed" || second_closed.value != "closed"; do
    stdio.stdout.write("FAIL:tab-close"); return;
  fi
  stdio.stdout.write("browser:tab-session-ok");
  return;
}
