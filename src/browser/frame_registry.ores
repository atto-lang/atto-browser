// Bounded WindowFrameRegistry — Oreslang-owned frame/renderer state.
// NOT a process launcher, URL resolver, physical OS sandbox or web renderer.
// Trusted WindowSupervisor MUST be the sole caller: fields are fixture IDs,
// not capability/authentication receipts. This module is a first real dynamic
// array-backed registry, replacing the fixed two-tab/three-frame example.
// Max 64 live frames, 32 renderer instances, 256 total frame/renderer slots
// (tombstones reuse physical slots, but never reuse logical IDs).
define module frame_registry as
  pub define class Registry as
    pub val int window_id;
    pub val int profile_id;
    pub val int partition_id;
    let int next_frame_id = 1;
    let int revision = 1;
    val Array<int> frame_ids;
    val Array<int> tab_ids;
    val Array<int> parent_ids;
    val Array<int> renderer_ids;
    val Array<int> renderer_generations;
    val Array<int> site_ids;
    val Array<int> origin_ids;
    val Array<int> epochs;
    val Array<int> frame_live;
    val Array<int> process_ids;
    val Array<int> process_generations;
    val Array<int> process_site_ids;
    val Array<int> process_actor_ids;
    val Array<int> process_origin_locks;
    val Array<int> process_live;
    val Array<int> process_ipc_pins;
    val Array<int> process_surface_pins;

    pub constructor(int window_id, int profile_id, int partition_id) {
      self.window_id = window_id;
      self.profile_id = profile_id;
      self.partition_id = partition_id;
      self.frame_ids = new Array<int>();
      self.tab_ids = new Array<int>();
      self.parent_ids = new Array<int>();
      self.renderer_ids = new Array<int>();
      self.renderer_generations = new Array<int>();
      self.site_ids = new Array<int>();
      self.origin_ids = new Array<int>();
      self.epochs = new Array<int>();
      self.frame_live = new Array<int>();
      self.process_ids = new Array<int>();
      self.process_generations = new Array<int>();
      self.process_site_ids = new Array<int>();
      self.process_actor_ids = new Array<int>();
      self.process_origin_locks = new Array<int>();
      self.process_live = new Array<int>();
      self.process_ipc_pins = new Array<int>();
      self.process_surface_pins = new Array<int>();
    }

    pub revision_number(): int { return self.revision; }
    pub frame_total_slots(): int { return self.frame_ids.size; }

    pub find_frame(int frame_id): int {
      if frame_id <= 0; then return -1; fi
      for (let i = 0; i < self.frame_ids.size; i++) {
        if self.frame_live.get(i) == 1 &&
           self.frame_ids.get(i) == frame_id; then return i; fi
      }
      return -1;
    }

    pub find_process(int renderer_id): int {
      if renderer_id <= 0; then return -1; fi
      for (let i = 0; i < self.process_ids.size; i++) {
        if self.process_live.get(i) == 1 &&
           self.process_ids.get(i) == renderer_id; then return i; fi
      }
      return -1;
    }

    pub live_frames(): int {
      let int total = 0;
      for (const live of self.frame_live) {
        if live == 1; then total = total + 1; fi
      }
      return total;
    }

    pub live_processes(): int {
      let int total = 0;
      for (const live of self.process_live) {
        if live == 1; then total = total + 1; fi
      }
      return total;
    }

    pub reference_count(int renderer_id): int {
      let int total = 0;
      for (let i = 0; i < self.frame_ids.size; i++) {
        if self.frame_live.get(i) == 1 &&
           self.renderer_ids.get(i) == renderer_id; then
          total = total + 1;
        fi
      }
      return total;
    }

    // Register exactly one trusted actor per renderer process identity.
    // Caller supplies broker-verified site, origin-strict lock and process
    // handle; this function cannot prove the caller is trusted.
    pub fnc register_process(mut self)(int renderer_id, int generation,
        int site_id, int actor_id, int origin_lock): bool {
      if self.window_id <= 0 || self.profile_id <= 0 ||
         self.partition_id <= 0 || renderer_id <= 0 ||
         generation <= 0 || site_id <= 0 || actor_id <= 0 ||
         origin_lock < 0; then return false; fi
      if self.live_processes() >= 32 || self.revision >= 2147483646; then
        return false;
      fi
      if self.find_process(renderer_id) >= 0; then return false; fi
      // Logical renderer IDs and actor IDs cannot be reused within this
      // window session, including after a crash or successful retirement.
      for (let i = 0; i < self.process_ids.size; i++) {
        if self.process_ids.get(i) == renderer_id ||
           self.process_actor_ids.get(i) == actor_id; then return false; fi
      }
      if self.process_ids.size >= 256; then return false; fi
      self.process_ids.add(renderer_id);
      self.process_generations.add(generation);
      self.process_site_ids.add(site_id);
      self.process_actor_ids.add(actor_id);
      self.process_origin_locks.add(origin_lock);
      self.process_live.add(1);
      self.process_ipc_pins.add(0);
      self.process_surface_pins.add(0);
      self.revision = self.revision + 1;
      return true;
    }

    // Resolve a renderer from a broker-authorized classification; a
    // same-site renderer cannot override an origin-strict lock.
    pub permits_renderer(int renderer_id, int generation,
        int site_id, int origin_id): bool {
      val int pos = self.find_process(renderer_id);
      if pos < 0 || generation <= 0 || site_id <= 0 ||
         origin_id <= 0; then return false; fi
      if self.process_generations.get(pos) != generation ||
         self.process_site_ids.get(pos) != site_id; then return false; fi
      val int lock = self.process_origin_locks.get(pos);
      return lock == 0 || lock == origin_id;
    }

    pub fnc attach_frame(mut self)(int tab_id, int parent_id,
        int renderer_id, int generation,
        int site_id, int origin_id): int {
      if tab_id <= 0 || parent_id < 0 ||
         self.next_frame_id >= 2147483646 ||
         self.revision >= 2147483646; then return -1; fi
      if !self.permits_renderer(renderer_id, generation, site_id,
                                origin_id); then return -1; fi
      if self.live_frames() >= 64; then return -1; fi
      if parent_id == 0; then
        // Exactly one live root frame per tab.
        for (let i = 0; i < self.frame_ids.size; i++) {
          if self.frame_live.get(i) == 1 &&
             self.tab_ids.get(i) == tab_id &&
             self.parent_ids.get(i) == 0; then return -1; fi
        }
      else
        val int parent = self.find_frame(parent_id);
        if parent < 0 || self.tab_ids.get(parent) != tab_id ||
           self.renderer_ids.get(parent) <= 0; then
          // Crashed parent frames are inert until broker-authorized restore.
          return -1;
        fi
        // Cap depth and reject any inherited cyclic/invalid parent chain.
        let int cursor = parent_id;
        let int depth = 0;
        while cursor != 0 {
          if depth >= 16; then return -1; fi
          val int row = self.find_frame(cursor);
          if row < 0; then return -1; fi
          cursor = self.parent_ids.get(row);
          depth = depth + 1;
        }
      fi
      val int new_id = self.next_frame_id;
      let int slot = -1;
      for (let i = 0; i < self.frame_ids.size; i++) {
        if slot == -1 && self.frame_live.get(i) == 0; then
          slot = i;
        fi
      }
      if slot == -1; then
        if self.frame_ids.size >= 256; then return -1; fi
        self.frame_ids.add(new_id);
        self.tab_ids.add(tab_id);
        self.parent_ids.add(parent_id);
        self.renderer_ids.add(renderer_id);
        self.renderer_generations.add(generation);
        self.site_ids.add(site_id);
        self.origin_ids.add(origin_id);
        self.epochs.add(1);
        self.frame_live.add(1);
      else
        self.frame_ids.set(slot, new_id);
        self.tab_ids.set(slot, tab_id);
        self.parent_ids.set(slot, parent_id);
        self.renderer_ids.set(slot, renderer_id);
        self.renderer_generations.set(slot, generation);
        self.site_ids.set(slot, site_id);
        self.origin_ids.set(slot, origin_id);
        self.epochs.set(slot, 1);
        self.frame_live.set(slot, 1);
      fi
      self.next_frame_id = self.next_frame_id + 1;
      self.revision = self.revision + 1;
      return new_id;
    }

    pub frame_epoch(int frame_id): int {
      val int row = self.find_frame(frame_id);
      if row < 0; then return -1; fi
      return self.epochs.get(row);
    }

    pub frame_renderer(int frame_id): int {
      val int row = self.find_frame(frame_id);
      if row < 0; then return -1; fi
      return self.renderer_ids.get(row);
    }

    // Source/target epochs checked before any mutation. This is the
    // commit half of a pending navigation, not a network redirect parser.
    pub fnc commit_navigation(mut self)(int frame_id, int expected_epoch,
        int renderer_id, int generation,
        int site_id, int origin_id): bool {
      val int row = self.find_frame(frame_id);
      if row < 0 || expected_epoch <= 0 ||
         self.epochs.get(row) != expected_epoch ||
         expected_epoch >= 2147483646 ||
         self.revision >= 2147483646; then return false; fi
      if !self.permits_renderer(renderer_id, generation, site_id,
                                origin_id); then return false; fi
      self.renderer_ids.set(row, renderer_id);
      self.renderer_generations.set(row, generation);
      self.site_ids.set(row, site_id);
      self.origin_ids.set(row, origin_id);
      self.epochs.set(row, expected_epoch + 1);
      self.revision = self.revision + 1;
      return true;
    }

    // A detached root/child closes all descendants regardless of their
    // renderer. Bound parent traversal to the 16-level admission budget.
    pub fnc close_subtree(mut self)(int frame_id, int expected_epoch): int {
      val int root = self.find_frame(frame_id);
      if root < 0 || expected_epoch <= 0 ||
         self.epochs.get(root) != expected_epoch ||
         self.revision >= 2147483646; then return -1; fi
      // TWO PHASES: compute descendants from an unchanged live graph,
      // then commit all tombstones. Marking the root early would cause
      // later descendants to lose their parent during traversal.
      let mut Array<int> closing = new Array<int>();
      let int count = 0;
      for (let i = 0; i < self.frame_ids.size; i++) {
        let int should_close = 0;
        if self.frame_live.get(i) == 1; then
          let int cursor = self.frame_ids.get(i);
          let int depth = 0;
          while cursor != 0 && depth <= 16 {
            if cursor == frame_id; then
              should_close = 1;
              cursor = 0;
            else
              val int ancestor = self.find_frame(cursor);
              if ancestor < 0; then
                cursor = 0;
              else
                cursor = self.parent_ids.get(ancestor);
              fi
            fi
            depth = depth + 1;
          }
        fi
        closing.add(should_close);
        if should_close == 1; then count = count + 1; fi
      }
      for (let i = 0; i < closing.size; i++) {
        if closing.get(i) == 1; then
          self.frame_live.set(i, 0);
        fi
      }
      if count > 0; then self.revision = self.revision + 1; fi
      return count;
    }

    // Browser-owned in-flight IPC and compositor handles prevent renderer
    // retirement even after the last frame closes or navigates away.
    pub fnc pin_ipc(mut self)(int renderer_id, int generation): bool {
      val int row = self.find_process(renderer_id);
      if row < 0 || generation <= 0 ||
         self.process_generations.get(row) != generation ||
         self.process_ipc_pins.get(row) >= 1024; then return false; fi
      self.process_ipc_pins.set(row, self.process_ipc_pins.get(row) + 1);
      return true;
    }
    pub fnc settle_ipc(mut self)(int renderer_id, int generation): bool {
      val int row = self.find_process(renderer_id);
      if row < 0 || generation <= 0 ||
         self.process_generations.get(row) != generation ||
         self.process_ipc_pins.get(row) <= 0; then return false; fi
      self.process_ipc_pins.set(row, self.process_ipc_pins.get(row) - 1);
      return true;
    }
    pub fnc pin_surface(mut self)(int renderer_id, int generation): bool {
      val int row = self.find_process(renderer_id);
      if row < 0 || generation <= 0 ||
         self.process_generations.get(row) != generation ||
         self.process_surface_pins.get(row) >= 1024; then return false; fi
      self.process_surface_pins.set(row,
          self.process_surface_pins.get(row) + 1);
      return true;
    }
    pub fnc settle_surface(mut self)(int renderer_id, int generation): bool {
      val int row = self.find_process(renderer_id);
      if row < 0 || generation <= 0 ||
         self.process_generations.get(row) != generation ||
         self.process_surface_pins.get(row) <= 0; then return false; fi
      self.process_surface_pins.set(row,
          self.process_surface_pins.get(row) - 1);
      return true;
    }

    pub can_retire(int renderer_id, int generation): bool {
      val int row = self.find_process(renderer_id);
      if row < 0 || generation <= 0 ||
         self.process_generations.get(row) != generation; then
        return false;
      fi
      return self.reference_count(renderer_id) == 0 &&
        self.process_ipc_pins.get(row) == 0 &&
        self.process_surface_pins.get(row) == 0;
    }

    pub fnc retire_process(mut self)(int renderer_id, int generation,
                                     bool supervisor_receipt): bool {
      val int row = self.find_process(renderer_id);
      if !supervisor_receipt || row < 0 ||
         self.revision >= 2147483646 ||
         !self.can_retire(renderer_id, generation); then return false; fi
      self.process_live.set(row, 0);
      self.revision = self.revision + 1;
      return true;
    }

    // Trusted launcher sends a death notice for an exact process generation.
    // All frames bound to the crashed process become inert placeholders.
    // The process ID is retired; reattach only after a NEW actor/process ID.
    pub fnc crash_process(mut self)(int renderer_id, int generation,
                                    bool trusted_launcher_receipt): int {
      val int row = self.find_process(renderer_id);
      if !trusted_launcher_receipt || row < 0 || generation <= 0 ||
         self.process_generations.get(row) != generation ||
         self.revision >= 2147483646; then return -1; fi
      for (let i = 0; i < self.frame_ids.size; i++) {
        if self.frame_live.get(i) == 1 &&
           self.renderer_ids.get(i) == renderer_id &&
           self.epochs.get(i) >= 2147483646; then return -1; fi
      }
      let int affected = 0;
      for (let i = 0; i < self.frame_ids.size; i++) {
        if self.frame_live.get(i) == 1 &&
           self.renderer_ids.get(i) == renderer_id; then
          self.renderer_ids.set(i, 0);
          self.renderer_generations.set(i, 0);
          self.epochs.set(i, self.epochs.get(i) + 1);
          affected = affected + 1;
        fi
      }
      self.process_live.set(row, 0);
      // Pins are invalidated by the broker on process crash; no late
      // receipt for a recycled renderer ID may become authoritative.
      self.process_ipc_pins.set(row, 0);
      self.process_surface_pins.set(row, 0);
      self.revision = self.revision + 1;
      return affected;
    }

    // A live document may only use an exact frame epoch and exact
    // sandboxed renderer generation; site-wide reuse never grants DOM.
    pub accepts_surface(int frame_id, int epoch, int renderer_id,
                         int generation): bool {
      val int row = self.find_frame(frame_id);
      if row < 0 || epoch <= 0 || renderer_id <= 0 ||
         generation <= 0; then return false; fi
      return self.epochs.get(row) == epoch &&
        self.renderer_ids.get(row) == renderer_id &&
        self.renderer_generations.get(row) == generation &&
        self.find_process(renderer_id) >= 0;
    }
  end
end
